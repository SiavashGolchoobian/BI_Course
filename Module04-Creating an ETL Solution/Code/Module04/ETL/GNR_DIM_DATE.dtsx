          DTS:ObjectName="SQL-UpdateDatePeriod"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables>
            <DTS:Variable
              DTS:CreationName=""
              DTS:DTSID="{6AAEEAFA-8877-42D4-9136-A75201A60776}"
              DTS:EvaluateAsExpression="True"
              DTS:Expression="&quot;&#xA;DECLARE @myToday DATE = GETDATE()&#xA;UPDATE [GNR].[DIM_Date] SET &#xA;&#x9;[PeriodCode]=-1,&#xA;&#x9;[PeriodNameEn]=N'Past',&#xA;&#x9;[PeriodNameFa]=N'گذشته'&#xA;WHERE GregorianDate&lt;=@myToday&#xA;UPDATE [GNR].[DIM_Date] SET &#xA;&#x9;[PeriodCode]=0,&#xA;&#x9;[PeriodNameEn]=N'Present',&#xA;&#x9;[PeriodNameFa]=N'روزجاری'&#xA;WHERE GregorianDate=@myToday&#xA;UPDATE [GNR].[DIM_Date] SET &#xA;&#x9;[PeriodCode]=1,&#xA;&#x9;[PeriodNameEn]=N'Future',&#xA;&#x9;[PeriodNameFa]=N'آینده'&#xA;WHERE GregorianDate&gt;@myToday&#xA;&quot;"
              DTS:IncludeInDebugDump="2345"
              DTS:Namespace="User"
              DTS:ObjectName="varStatement">
              <DTS:VariableValue
                DTS:DataType="8">
DECLARE @myToday DATE = GETDATE()
UPDATE [GNR].[DIM_Date] SET 
	[PeriodCode]=-1,
	[PeriodNameEn]=N'Past',
	[PeriodNameFa]=N'گذشته'
WHERE GregorianDate&lt;=@myToday
UPDATE [GNR].[DIM_Date] SET 
	[PeriodCode]=0,
	[PeriodNameEn]=N'Present',
	[PeriodNameFa]=N'روزجاری'
WHERE GregorianDate=@myToday
UPDATE [GNR].[DIM_Date] SET 
	[PeriodCode]=1,
	[PeriodNameEn]=N'Future',
	[PeriodNameFa]=N'آینده'
WHERE GregorianDate&gt;@myToday
</DTS:VariableValue>
            </DTS:Variable>
          </DTS:Variables>
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{46A55289-70E1-4B48-93DF-30D1DADDD16A}"
              SQLTask:SqlStmtSourceType="Variable"
              SQLTask:SqlStatementSource="User::varStatement" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
