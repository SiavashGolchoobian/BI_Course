                  refId="Package\SEQC-EXTRACT\DFT-Extract_Sale\OLE_SRC-Extract_SaleOrderHeader"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE_SRC-Extract_SaleOrderHeader"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
	[myHeader].[SalesOrderID],
	[myHeader].[SalesOrderNumber],
	[myHeader].[OrderDate],
	[myHeader].[ShipDate],
	[myHeader].[CustomerID],
	[myCustomerPerson].[BusinessEntityID] AS BKCustomer,
	[myHeader].[SalesPersonID],
	[mySalesPerson].[BusinessEntityID] AS BKSalesPerson,
	[myHeader].[TerritoryID],
	[myTerritory].[Name] AS BKTerritory,
	[myHeader].[rowguid],
	[myHeader].[ModifiedDate]
FROM
	[Sales].[SalesOrderHeader] AS myHeader
	LEFT OUTER JOIN [Sales].[Customer] AS myCustomer ON [myHeader].[CustomerID]=[myCustomer].[CustomerID]
	LEFT OUTER JOIN [Person].[Person] AS myCustomerPerson ON [myCustomer].[PersonID]=[myCustomerPerson].[BusinessEntityID]
	LEFT OUTER JOIN [Person].[Person] AS mySalesPerson ON [myHeader].[SalesPersonID]=[mySalesPerson].[BusinessEntityID]
	LEFT OUTER JOIN [Sales].[SalesTerritory] AS myTerritory ON [myHeader].[TerritoryID]=[myTerritory].[TerritoryID]</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
