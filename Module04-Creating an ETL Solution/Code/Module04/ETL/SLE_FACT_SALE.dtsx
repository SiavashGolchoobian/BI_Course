                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
	[myData].[Id],
	[myData].[SalesOrderNumber],
	[myData].[LineTotal],
	[myData].[OrderQty],
	[myData].[SalesOrderDetailID],
	[myData].[ProductRef],
	[myData].[CustomerRef],
	[myData].[SalesPersonRef],
	[myData].[TerritoryRef],
	[myData].[OrderDateRef],
	[myData].[ShipDateRef],
	[myData].[UnitPrice],
	[myData].[UnitPriceDiscount],
	[myData].[OltpHashValue],
	[myAction].[Action],
	[myAction].[DwhId]
FROM
	[TRANSFORM].[SLE_FACT_Sale01_Combine] AS myData
	INNER JOIN [TRANSFORM].[SLE_FACT_Sale02_Action] AS myAction ON myData.Id=myAction.Id</property>
                    <property
