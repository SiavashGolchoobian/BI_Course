                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
	[myDetail].[Id],
	[myHeader].[SalesOrderNumber],
	[myDetail].[BKProduct],
	[myHeader].[BKCustomer],
	[myHeader].[BKSalesPerson],
	[myHeader].[BKTerritory],
	CAST([myHeader].[OrderDate] AS DATE) AS [OrderDate],
	CAST([myHeader].[ShipDate] AS DATE) AS [ShipDate],
	[myDetail].[UnitPrice],
	[myDetail].[UnitPriceDiscount],
	[myDetail].[LineTotal],
	[myDetail].[OrderQty],
	[myDetail].[SalesOrderDetailID]
FROM
	[Extract].[SLE_FACT_Sale01_Header] AS myHeader
	INNER JOIN [Extract].[SLE_FACT_Sale02_Detail] AS myDetail ON [myHeader].[SalesOrderID]=[myDetail].[SalesOrderID]</property>
