                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
	[myDetail].[SalesOrderID],
	[myDetail].[SalesOrderDetailID],
	[myDetail].[ProductID],
	[myProduct].[ProductNumber] AS BKProduct,
	[myDetail].[UnitPrice],
	[myDetail].[UnitPriceDiscount],
	[myDetail].[LineTotal],
	[myDetail].[OrderQty],
	[myDetail].[rowguid],
	[myDetail].[ModifiedDate]
FROM
	[Sales].[SalesOrderDetail] AS myDetail
	INNER JOIN [Production].[Product] AS myProduct ON [myDetail].[ProductID]=[myProduct].[ProductID]</property>
